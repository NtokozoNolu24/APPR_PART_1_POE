@model IEnumerable<APPR_PART_1_POE.Models.Volunteer>

@{
    ViewData["Title"] = "Volunteer Sign-Ups";
}

<section class="py-5">

    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>

                <p class="text-warning fw-bold mb-2">
                    EMPLOYEE PORTAL
                </p>

                <h1 class="fw-bold mb-1">
                    Volunteer Sign-Ups
                </h1>

                <p class="text-muted mb-0">
                    Review volunteers who have registered their interest.
                </p>

            </div>

            <a asp-action="Dashboard"
               class="btn btn-outline-dark">

                Back to Dashboard

            </a>

        </div>


        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Full Name</th>
                            <th>Skills</th>
                            <th>Availability</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var volunteer in Model)
                        {
                            <tr>

                                <td>@volunteer.Name</td>

                                <td>@volunteer.Skills</td>

                                <td>@volunteer.Availability</td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="alert alert-light border">

                No volunteer registrations have been submitted yet.

            </div>
        }

    </div>

</section>