@model APPR_PART_1_POE.Models.Donation

@{
    ViewData["Title"] = "Donate";
}

<section class="py-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-7">

                <div class="text-center mb-5">

                    <p class="text-warning fw-bold">
                        SUPPORT OUR RELIEF EFFORTS
                    </p>

                    <h1 class="fw-bold">
                        Make a Donation
                    </h1>

                    <p class="text-muted">
                        Your contribution helps support humanitarian and
                        disaster relief efforts.
                    </p>

                </div>


                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4 p-md-5">

                        <form asp-action="Index" method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>


                            <!-- Donation Amount -->

                            <div class="mb-3">

                                <label asp-for="Amount"
                                       class="form-label">
                                </label>

                                <input asp-for="Amount"
                                       class="form-control"
                                       placeholder="Enter donation amount" />

                                <span asp-validation-for="Amount"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Donation Type -->

                            <div class="mb-3">

                                <label asp-for="DonationType"
                                       class="form-label">
                                    Donation Type
                                </label>

                                <select asp-for="DonationType"
                                        class="form-select">

                                    <option value="">
                                        Select donation type
                                    </option>

                                    <option value="One-Time">
                                        One-Time Donation
                                    </option>

                                    <option value="Recurring">
                                        Recurring Donation
                                    </option>

                                </select>

                                <span asp-validation-for="DonationType"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Currency -->

                            <div class="mb-3">

                                <label asp-for="Currency"
                                       class="form-label">
                                    Currency
                                </label>

                                <select asp-for="Currency"
                                        class="form-select">

                                    <option value="">
                                        Select currency
                                    </option>

                                    <option value="ZAR">
                                        ZAR – South African Rand
                                    </option>

                                    <option value="USD">
                                        USD – US Dollar
                                    </option>

                                    <option value="EUR">
                                        EUR – Euro
                                    </option>

                                </select>

                                <span asp-validation-for="Currency"
                                      class="text-danger">
                                </span>

                            </div>


                            <!-- Anonymous Donation -->

                            <div class="form-check mb-4">

                                <input asp-for="IsAnonymous"
                                       class="form-check-input" />

                                <label asp-for="IsAnonymous"
                                       class="form-check-label">

                                    Donate anonymously

                                </label>

                            </div>


                            <button type="submit"
                                    class="btn btn-dark w-100">

                                Continue to Donation

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}