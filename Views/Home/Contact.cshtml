@{
    ViewData["Title"] = "Contact";
}

<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <p class="text-warning fw-bold">
                CONTACT US
            </p>

            <h1 class="fw-bold">
                Get in Touch
            </h1>

            <p class="text-muted">
                Contact the Gift of the Givers Foundation to learn more about
                our humanitarian and relief initiatives.
            </p>

        </div>


        <div class="row justify-content-center g-4">

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100 text-center">

                    <div class="card-body p-4">

                        <h5 class="fw-bold">
                            General Enquiries
                        </h5>

                        <p class="text-muted mb-0">
                            Contact us for general information about our
                            humanitarian work and initiatives.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100 text-center">

                    <div class="card-body p-4">

                        <h5 class="fw-bold">
                            Donations
                        </h5>

                        <p class="text-muted mb-0">
                            Learn more about supporting relief operations
                            through donations and contributions.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100 text-center">

                    <div class="card-body p-4">

                        <h5 class="fw-bold">
                            Volunteering
                        </h5>

                        <p class="text-muted mb-0">
                            Find out how you can register your interest in
                            supporting communities through volunteering.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>