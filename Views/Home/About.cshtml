@{
    ViewData["Title"] = "About";
}

<section class="py-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-9">

                <p class="text-warning fw-bold">
                    ABOUT US
                </p>

                <h1 class="display-5 fw-bold mb-4">
                    Compassion in Action
                </h1>

                <p class="lead text-muted mb-4">
                    The Gift of the Givers Foundation is dedicated to providing
                    humanitarian assistance and supporting communities affected
                    by disasters, emergencies and other crises.
                </p>

                <p>
                    Through compassion, efficiency and resilience, the foundation
                    works to provide meaningful assistance to people in need.
                    Relief efforts are supported through the coordination of
                    volunteers, donors, resources and humanitarian expertise.
                </p>

                <p>
                    This prototype web application supports the future vision of
                    a centralised digital platform for coordinating relief
                    operations, volunteer participation and resource support.
                </p>

            </div>

        </div>

    </div>

</section>


<section class="py-5 bg-light">

    <div class="container">

        <div class="row g-4 text-center">

            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <h4 class="fw-bold">
                            Compassion
                        </h4>

                        <p class="text-muted mb-0">
                            Responding to the needs of communities with care,
                            empathy and humanity.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <h4 class="fw-bold">
                            Efficiency
                        </h4>

                        <p class="text-muted mb-0">
                            Coordinating people and resources to ensure support
                            reaches communities effectively.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <h4 class="fw-bold">
                            Resilience
                        </h4>

                        <p class="text-muted mb-0">
                            Supporting communities as they recover, rebuild and
                            move forward after difficult circumstances.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>