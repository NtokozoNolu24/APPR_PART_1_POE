@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="py-5 bg-light">

    <div class="container py-5">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <p class="text-warning fw-bold mb-2">
                    HUMANITARIAN RELIEF AND HOPE
                </p>

                <h1 class="display-4 fw-bold mb-4">
                    Making a Difference When Communities Need It Most
                </h1>

                <p class="lead text-muted mb-4">
                    Gift of the Givers provides humanitarian assistance and
                    disaster relief to communities affected by crises and
                    emergencies in South Africa and beyond.
                </p>

                <a asp-controller="Donation"
                   asp-action="Index"
                   class="btn btn-dark btn-lg me-2">
                    Donate Now
                </a>

                <a asp-controller="Volunteer"
                   asp-action="Index"
                   class="btn btn-outline-dark btn-lg">
                    Become a Volunteer
                </a>

            </div>

            <div class="col-lg-5 mt-4 mt-lg-0">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <h4 class="fw-bold">
                            Responding to Crisis
                        </h4>

                        <p class="text-muted mb-0">
                            Through coordinated relief efforts, dedicated
                            volunteers and generous donors, we work to provide
                            essential support to communities facing difficult
                            circumstances.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- What We Do Section -->
<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <p class="text-warning fw-bold">
                WHAT WE DO
            </p>

            <h2 class="fw-bold">
                Supporting Communities Through Every Crisis
            </h2>

        </div>


        <div class="row g-4">

            <div class="col-md-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body p-4">

                        <h4 class="fw-bold">
                            Disaster Relief
                        </h4>

                        <p class="text-muted">
                            Providing essential assistance to communities
                            affected by natural disasters and emergencies.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body p-4">

                        <h4 class="fw-bold">
                            Resource Support
                        </h4>

                        <p class="text-muted">
                            Coordinating food, essential supplies and other
                            resources where they are needed most.
                        </p>

                    </div>

                </div>

            </div>


            <div class="col-md-4">

                <div class="card h-100 border-0 shadow-sm">

                    <div class="card-body p-4">

                        <h4 class="fw-bold">
                            Community Support
                        </h4>

                        <p class="text-muted">
                            Working with volunteers and communities to restore
                            hope and build resilience after a crisis.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- Call to Action -->
<section class="py-5 bg-dark text-white">

    <div class="container text-center">

        <h2 class="fw-bold mb-3">
            Together, We Can Make a Difference
        </h2>

        <p class="mb-4">
            Your support can help us reach communities and respond when help
            is needed most.
        </p>

        <a asp-controller="Donation"
           asp-action="Index"
           class="btn btn-warning btn-lg">
            Support Our Relief Efforts
        </a>

    </div>

</section>