@model APPR_PART_1_POE.Models.Volunteer

@{
    ViewData["Title"] = "Volunteer";
}

<section class="py-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-7">

                <div class="text-center mb-5">

                    <p class="text-warning fw-bold">
                        VOLUNTEER WITH US
                    </p>

                    <h1 class="fw-bold">
                        Register Your Interest
                    </h1>

                    <p class="text-muted">
                        Join us in supporting communities and helping during
                        times of crisis.
                    </p>

                </div>


                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4 p-md-5">

                        <form asp-action="Index" method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3">
                            </div>


                            <div class="mb-3">

                                <label asp-for="Name"
                                       class="form-label">
                                </label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Enter your full name" />

                                <span asp-validation-for="Name"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="mb-3">

                                <label asp-for="Skills"
                                       class="form-label">
                                </label>

                                <textarea asp-for="Skills"
                                          class="form-control"
                                          rows="4"
                                          placeholder="For example: First aid, driving, administration">
                                </textarea>

                                <span asp-validation-for="Skills"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="mb-4">

                                <label asp-for="Availability"
                                       class="form-label">
                                </label>

                                <input asp-for="Availability"
                                       class="form-control"
                                       placeholder="For example: Weekends or weekdays after 17:00" />

                                <span asp-validation-for="Availability"
                                      class="text-danger">
                                </span>

                            </div>


                            <button type="submit"
                                    class="btn btn-dark w-100">

                                Submit Volunteer Registration

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}